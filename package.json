{
  "name": "znake",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "check": "biome check . && node tools/architecture-guardrails.mjs && pnpm -s validate:fairness",
    "check:fix": "biome check --write .",
    "format": "biome format --write .",
    "graph:build": "graphify update .",
    "graph:query": "./tools/graph-query.sh",
    "graph:check": "command -v graphify >/dev/null 2>&1 && [ -f graphify-out/GRAPH_REPORT.md ] && echo 'graphify available and graph report present' || (echo 'Graphify missing or graph report missing. Run pnpm graph:build.' >&2; exit 1)",
    "graphify:build": "pnpm graph:build",
    "graphify:report": "node -e \"const fs=require('node:fs');const p='graphify-out/GRAPH_REPORT.md';if(fs.existsSync(p)){console.log(p);}else{console.error('Missing '+p+'. Run pnpm graph:build first.');process.exit(1);}\"",
    "graphify:clean": "node -e \"require('node:fs').rmSync('graphify-out',{recursive:true,force:true});console.log('Removed graphify-out/');\"",
    "smoke": "node --import tsx tools/smoke-playtest.ts",
    "smoke:baseline": "pnpm smoke --write-baseline",
    "autoloop": "node tools/autoloop.mjs",
    "autoloop:auto": "node tools/autoloop.mjs --autoarchive --autocommit",
    "autoloop:report": "cat .autoloop/loop-report.json",
    "release:meta": "node tools/release-meta.mjs print",
    "release:meta:env": "node tools/release-meta.mjs env",
    "release:meta:validate": "node tools/release-meta.mjs validate",
    "build:channel:dev": "node tools/release-meta.mjs build dev",
    "build:channel:stage": "node tools/release-meta.mjs build stage",
    "build:channel:prod": "node tools/release-meta.mjs build prod",
    "stitch:map": "node --import tsx tools/stitch-phaser-mapper/cli.ts",
    "generate:sprites": "node --import tsx tools/generate-sprites.ts",
    "validate:markers": "node --import tsx tools/marker-pipeline-check.ts",
    "validate:visual-language": "node --import tsx tools/visual-language-check.ts",
    "validate:fairness": "node --import tsx tools/fairness-validation.ts",
    "sprites:svg2png": "node --import tsx tools/svg-to-png.ts",
    "sprites:dry-run": "pnpm sprites:svg2png --dry-run",
    "sprites:update": "pnpm sprites:svg2png && node --import tsx tools/pack-marker-atlas-from-pngs.ts && pnpm validate:markers"
  },
  "dependencies": {
    "i18next": "^25.8.18",
    "i18next-browser-languagedetector": "^8.2.1",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@napi-rs/canvas": "^0.1.97",
    "@resvg/resvg-js": "^2.6.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  },
  "packageManager": "pnpm@10.17.0"
}
