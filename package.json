{
  "name": "znake",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "format": "biome format --write .",
    "stitch:map": "node --import tsx tools/stitch-phaser-mapper/cli.ts",
    "generate:sprites": "node --import tsx tools/generate-sprites.ts",
    "validate:markers": "node --import tsx tools/marker-pipeline-check.ts",
    "sprites:svg2png": "node --import tsx tools/svg-to-png.ts"
  },
  "dependencies": {
    "i18next": "^25.8.18",
    "i18next-browser-languagedetector": "^8.2.1",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@napi-rs/canvas": "^0.1.97",
    "@resvg/resvg-js": "^2.6.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  },
  "packageManager": "pnpm@10.17.0"
}
